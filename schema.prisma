model FolderAccount {
  id            String    @id @unique @default(cuid())
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  displayName   String?
  isDeleted     Boolean?  @default(false)
  Company__fk__ String?
  Company       Company?  @relation(fields: [Company__fk__], references: [id])
  Account       Account[] @relation("AccountToFolderAccount")
}

model CustomerProfile {
  id               String            @id @unique @default(cuid())
  createdAt        DateTime          @default(now()) @db.Timestamp(6)
  updatedAt        DateTime          @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted        Boolean?          @default(false)
  customerCode     String            @unique
  status           CUSTOMER_STATUS   @default(ACTIVE)
  totalOrders      Int               @default(0)
  totalSpend       Decimal           @default(0) @db.Decimal(12, 2)
  lastOrderAt      DateTime?
  lastLoginAt      DateTime?
  gstin            String?
  walletBalance    Decimal           @default(0) @db.Decimal(12, 2)
  addressLine1     String?
  addressLine2     String?
  city             String?
  state            String?
  pincode          String?
  Company__fk__    String?
  Account__fk__    String            @unique
  Cart             Cart?
  ChargingSessions ChargingSession[]
  Account          Account           @relation(fields: [Account__fk__], references: [id], onDelete: Cascade)
  Company          Company?          @relation(fields: [Company__fk__], references: [id])
  CustomerVehicles CustomerVehicle[]
  FavoriteStations FavoriteStation[]
  Orders           Order[]
  Reviews          Review[]
  StationReview    StationReview[]
  Transaction      Transaction[]
  VehicleReviews   VehicleReview[]
  RfidTags         RfidTag[]
  RfidRequests     RfidRequest[]
  PromoCodeUsages  PromoCodeUsage[]
  // CustomerProfile model ke andar add honge:
  ReferralShares         ReferralShare[]      @relation("CustomerShares")
  ReferralsMade          ReferralUsage[]      @relation("CustomerReferralsMade")
  ReferredBy             ReferralUsage?       @relation("CustomerReferredBy")
  ReferralCommissions    ReferralCommission[] @relation("CustomerCommissions")

  @@index([Company__fk__])
  @@index([status])
}

model Cart {
