  isDeleted           Boolean?              @default(false)
  fields              Json?
  Project__fk__       String?
  Account__fk__       String?
  gstId               String?
  Scope__fk__         String?
  CompanyFeatureEntry CompanyFeatureEntry[]
  DynamicColumn       DynamicColumn[]
  Account             Account?              @relation(fields: [Account__fk__], references: [id])
  Project             Project?              @relation(fields: [Project__fk__], references: [id])
  Scope               Scope?                @relation(fields: [Scope__fk__], references: [id])
  Gst                 Gst?                  @relation(fields: [gstId], references: [id])
