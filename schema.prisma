generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["nativeDistinct", "relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_POSTGRES_WRITE_URL")
}

model Account {
  id                         String                       @id @unique @default(cuid())
  createdAt                  DateTime                     @default(now()) @db.Timestamp(6)
  updatedAt                  DateTime                     @default(now()) @updatedAt @db.Timestamp(6)
  isActive                   Boolean                      @default(false)
  fullName                   String?
  password                   String?
  isBlocked                  Boolean                      @default(false)
  thumbnailStoredAt          Json?                        @db.Json
  email                      String?                      @unique(map: "email_1676392778723_index")
  emailVerified              Boolean                      @default(false)
  verificationToken          String?
  verificationTokenExpiry    DateTime?
  address                    String?
  displayName                String?
  isDeleted                  Boolean?                     @default(false)
  phoneNumber                String?
  accountType                ACCOUNT_TYPE                 @default(EMPLOYEE)
  adminRole                  ADMIN_ROLE?
  is2FAEnabled               Boolean?  @default(false)
  twoFactorSecret            String?
  status                     ACCOUNT_STATUS               @default(INVITED)
  AccountStationAccess       AccountStationAccess[]
  ParentAccount__fk__        String?
  publicKey                  String?
  dateOfBirth                DateTime?
  gender                     String?
  ParentAccount              Account?                     @relation("AccountToChildren", fields: [ParentAccount__fk__], references: [id])
  ChildrenAccounts           Account[]                    @relation("AccountToChildren")
  Company                    Company[]
  CompanyFeatureEntry        CompanyFeatureEntry[]
  CompanyFeatureEntryHistory CompanyFeatureEntryHistory[]
  CustomerProfiles           CustomerProfile?
  DynamicColumn              DynamicColumn[]
  Feature                    Feature[]
  Gst                        Gst[]
  Invitations                Invitation[]                 @relation("InvitedBy")
  Project                    Project[]
  Scope                      Scope[]
  Workflow                   Workflow[]                   @relation("WorkflowOwner")
  FolderAccount              FolderAccount[]              @relation("AccountToFolderAccount")
  ProjectEmployee            ProjectEmployee[]            @relation("AccountToProjectEmployee")
  Role                       Role[]                       @relation("AccountToRole")
  ReferralCampaigns          ReferralCampaign[]
}

model DynamicColumn {
  id            String   @id @unique @default(cuid())
  createdAt     DateTime @default(now()) @db.Timestamp(6)
  updatedAt     DateTime @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted     Boolean? @default(false)
  fields        Json?
  Feature__fk__ String?
  Company__fk__ String?
  Account__fk__ String?
  Account       Account? @relation(fields: [Account__fk__], references: [id])
  Company       Company? @relation(fields: [Company__fk__], references: [id])
  Feature       Feature? @relation(fields: [Feature__fk__], references: [id])
}

model Company {
  id                  String                @id @unique @default(cuid())
  createdAt           DateTime              @default(now()) @db.Timestamp(6)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted           Boolean?              @default(false)
  displayName         String?
  address             String?
  phoneNumber         String?
  Account__fk__       String?
  ChargingStations    ChargingStation[]
  Account             Account?              @relation(fields: [Account__fk__], references: [id])
  CompanyFeatureEntry CompanyFeatureEntry[]
  CustomerProfiles    CustomerProfile[]
  DynamicColumn       DynamicColumn[]
  ElectricVehicles    ElectricVehicle[]
  FolderAccount       FolderAccount[]
  Gst                 Gst[]
  Orders              Order[]
  PartsCategories     PartsCategory[]
  Products            Product[]
  Project             Project[]
  Role                Role[]
  Scope               Scope[]
  Transaction         Transaction[]
  VehiclesCategories  VehiclesCategory[]
  Workflow            Workflow[]
}

model CompanyFeatureEntry {
  id                         String                       @id @unique @default(cuid())
  createdAt                  DateTime                     @default(now()) @db.Timestamp(6)
  updatedAt                  DateTime                     @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted                  Boolean?                     @default(false)
  data                       Json?
  Feature__fk__              String?
  Company__fk__              String?
  Account__fk__              String?
  Project__fk__              String?
  Account                    Account?                     @relation(fields: [Account__fk__], references: [id])
  Company                    Company?                     @relation(fields: [Company__fk__], references: [id])
  Feature                    Feature?                     @relation(fields: [Feature__fk__], references: [id])
  Project                    Project?                     @relation(fields: [Project__fk__], references: [id])
  CompanyFeatureEntryHistory CompanyFeatureEntryHistory[]
}

model CompanyFeatureEntryHistory {
  id                        String               @id @unique @default(cuid())
  createdAt                 DateTime             @default(now()) @db.Timestamp(6)
  updatedAt                 DateTime             @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted                 Boolean?             @default(false)
  fromData                  Json?
  toData                    Json?
  CompanyFeatureEntry__fk__ String?
  ChangedByAccount__fk__    String?
  ChangedByAccount          Account?             @relation(fields: [ChangedByAccount__fk__], references: [id])
  CompanyFeatureEntry       CompanyFeatureEntry? @relation(fields: [CompanyFeatureEntry__fk__], references: [id])
}

model Order {
  id                    String           @id @unique @default(cuid())
  createdAt             DateTime         @default(now()) @db.Timestamp(6)
  updatedAt             DateTime         @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted             Boolean?         @default(false)
  orderCode             String           @unique
  status                ORDER_STATUS     @default(PENDING)
  totalAmount           Decimal          @db.Decimal(12, 2)
  currency              String           @default("USD")
  orderedAt             DateTime         @default(now())
  cancelledAt           DateTime?
  deliveredAt           DateTime?
  CustomerProfile__fk__ String?
  Company__fk__         String?
  Company               Company?         @relation(fields: [Company__fk__], references: [id])
  CustomerProfile       CustomerProfile? @relation(fields: [CustomerProfile__fk__], references: [id])
  Items                 OrderItem[]
  Payment               OrderPayment?
  Transactions          Transaction[]

  @@index([CustomerProfile__fk__])
  @@index([Company__fk__])
  @@index([status])
  @@index([orderedAt])
}

model OrderItem {
  id           String   @id @unique @default(cuid())
  createdAt    DateTime @default(now()) @db.Timestamp(6)
  updatedAt    DateTime @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted    Boolean? @default(false)
  quantity     Int      @default(1)
  unitPrice    Decimal  @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(12, 2)
  ProductName  String
  ProductSku   String?
  ProductImage Json
  Order__fk__  String?
  Order        Order?   @relation(fields: [Order__fk__], references: [id], onDelete: Cascade)

  @@index([Order__fk__])
}

model OrderPayment {
  id            String          @id @unique @default(cuid())
  createdAt     DateTime        @default(now()) @db.Timestamp(6)
  updatedAt     DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted     Boolean?        @default(false)
  status        PAYMENT_STATUS  @default(UNPAID)
  method        PAYMENT_METHOD?
  transactionId String?
  amount        Decimal         @db.Decimal(12, 2)
  paidAt        DateTime?
  Order__fk__   String?         @unique
  Order         Order?          @relation(fields: [Order__fk__], references: [id], onDelete: Cascade)
}

model PartsCategory {
  id                   String          @id @unique @default(cuid())
  createdAt            DateTime        @default(now()) @db.Timestamp(6)
  updatedAt            DateTime        @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted            Boolean?        @default(false)
  name                 String
  slug                 String
  description          String?
  iconStoredAt         Json?
  imageStoredAt        Json?
  isActive             Boolean         @default(true)
  isFeatured           Boolean         @default(false)
  sortOrder            Int?
  Company__fk__        String?
  ParentCategory__fk__ String?
  Company              Company?        @relation(fields: [Company__fk__], references: [id])
  ParentCategory       PartsCategory?  @relation("PartsCategoryHierarchy", fields: [ParentCategory__fk__], references: [id])
  SubCategories        PartsCategory[] @relation("PartsCategoryHierarchy")

  @@unique([slug, Company__fk__])
  @@index([Company__fk__])
  @@index([ParentCategory__fk__])
  @@index([isActive])
  @@index([isFeatured])
}

model VehiclesCategory {
  id                   String             @id @unique @default(cuid())
  createdAt            DateTime           @default(now()) @db.Timestamp(6)
  updatedAt            DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted            Boolean?           @default(false)
  name                 String
  slug                 String
  description          String?
  iconStoredAt         Json?
  imageStoredAt        Json?
  isActive             Boolean            @default(true)
  isFeatured           Boolean            @default(false)
  sortOrder            Int?
  Company__fk__        String?
  ParentCategory__fk__ String?
  Company              Company?           @relation(fields: [Company__fk__], references: [id])
  ParentCategory       VehiclesCategory?  @relation("VehiclesCategoryHierarchy", fields: [ParentCategory__fk__], references: [id])
  SubCategories        VehiclesCategory[] @relation("VehiclesCategoryHierarchy")

  @@unique([slug, Company__fk__])
  @@index([Company__fk__])
  @@index([ParentCategory__fk__])
  @@index([isActive])
  @@index([isFeatured])
}

model Transaction {
  id                    String             @id @unique @default(cuid())
  createdAt             DateTime           @default(now()) @db.Timestamp(6)
  updatedAt             DateTime           @default(now()) @updatedAt @db.Timestamp(6)
  isDeleted             Boolean?           @default(false)
  amount                Decimal            @db.Decimal(12, 2)
  currency              String             @default("USD")
  status                TRANSACTION_STATUS
  type                  TRANSACTION_TYPE
  gateway               PAYMENT_GATEWAY?
  gatewayTxnId          String?            @unique
  gatewayResponse       Json?
  paidAt                DateTime?
  failureReason         String?
  Order__fk__           String?
  Company__fk__         String?
  CustomerProfile__fk__ String?
  invoiceUrl            String?
  refundAmount          Decimal?           @default(0) @db.Decimal(12, 2)
  ChargingSession       ChargingSession?
  balanceAmount         Float?             @default(0.0)
  RfidTag__fk__         String?
  RfidTag               RfidTag?           @relation(fields: [RfidTag__fk__], references: [id])
  Company               Company?           @relation(fields: [Company__fk__], references: [id])
  CustomerProfile       CustomerProfile?   @relation(fields: [CustomerProfile__fk__], references: [id])
  Order                 Order?             @relation(fields: [Order__fk__], references: [id], onDelete: Cascade)
  PromoCodeUsage        PromoCodeUsage[]

  @@index([Order__fk__])
  @@index([Company__fk__])
  @@index([status])
  @@index([gatewayTxnId])
  @@index([createdAt])
}

model Project {
  id                  String                @id @unique @default(cuid())
  createdAt           DateTime              @default(now()) @db.Timestamp(6)
  updatedAt           DateTime              @default(now()) @updatedAt @db.Timestamp(6)
  displayName         String?
  description         String?
  account             Json?
  isDeleted           Boolean?              @default(false)
  Account__fk__       String?
  Company__fk__       String?
  CompanyFeatureEntry CompanyFeatureEntry[]
  Feature             Feature[]
  Account             Account?              @relation(fields: [Account__fk__], references: [id])
  Company             Company?              @relation(fields: [Company__fk__], references: [id])
  ProjectEmployee     ProjectEmployee[]
  Workflow            Workflow[]
}

model Scope {
  id                String    @id @unique @default(cuid())
  createdAt         DateTime  @default(now()) @db.Timestamp(6)
  updatedAt         DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  displayName       String?
  description       String?
  isDeleted         Boolean?  @default(false)
  feature           Json?
  role              Json?
  isAllowedToCreate Boolean?
  isAllowedToUpdate Boolean?
  isAllowedToDelete Boolean?
  isAllowedToRead   Boolean?
  Company__fk__     String?
  Account__fk__     String?
  Feature           Feature[]
  Role              Role[]
  Account           Account?  @relation(fields: [Account__fk__], references: [id])
  Company           Company?  @relation(fields: [Company__fk__], references: [id])
}

model Gst {
  id            String    @id @unique @default(cuid())
  createdAt     DateTime  @default(now()) @db.Timestamp(6)
  updatedAt     DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  displayName   String?
