  ElectricVehicle__fk__ String?
  Cart                  Cart             @relation(fields: [Cart__fk__], references: [id], onDelete: Cascade)
  ElectricVehicle       ElectricVehicle? @relation(fields: [ElectricVehicle__fk__], references: [id], onDelete: Cascade)
  Product               Product?         @relation(fields: [Product__fk__], references: [id], onDelete: Cascade)
}

