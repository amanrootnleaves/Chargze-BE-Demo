  chargingTimeDC      String?
  chargerType         String?
  fastCharging        Boolean         @default(false)
  rangeKm             Int?
  topSpeedKmph        Int?
  motorPowerKW        Decimal?        @db.Decimal(8, 2)
  motorTorqueNm       Decimal?        @db.Decimal(8, 2)
