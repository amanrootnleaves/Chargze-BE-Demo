{
  "name": "chargze-be",
  "version": "1.0.1",
  "private": true,
  "lint-staged": {
    "*.{js,md, json}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "graphql": "16.8.0"
    },
    "ignoredBuiltDependencies": [
      "@apollo/protobufjs",
      "core-js",
      "core-js-pure",
      "prisma",
      "tld-list",
      "unix-dgram"
    ],
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "aws-sdk",
      "esbuild",
      "protobufjs",
      "sharp"
    ]
  },
  "workspaces": [
    "packages/**"
  ],
  "scripts": {
    "start": "node --env-file=.env .build/index.js",
    "pre-commit": "lint-staged && pnpm run build",
    "clean": "pnpm recursive run clean && rimraf node_modules pnpm-lock.yaml",
    "pm2": "pnpm run build && pm2 delete chargze-be || true && pm2 start .build/index.js --name chargze-be --node-args='--env-file=.env --max-old-space-size=24576'",
    "dev": "cross-env NODE_ENV=DEVELOPMENT DEBUG=*,-babel-watch:*,*pdu.command.out*,-babel,-babel:*,-prisma:*,-prisma:client:*,-express:*,-nodemon,-body-parser:json,-nodemon:*,-babel-watch:*,-winston:*,-ioredis:*,-nodemon::*,-snapdragon:*,-prisma-client,-finalhandler,-winston:create-logger,-follow-redirects babel-watch index.js",
    "copy::configuration": "npx shx cp package.json pnpm-workspace.yaml schema.prisma .env ./.build",
    "copy::files": "npx babel index.js --out-dir ./.build --root-mode upward",
    "prebuild": "rimraf .build && pnpm run copy::files && pnpm run copy::configuration && pnpm -r run build::js && node scripts/copy-assets.js && node scripts/cleanup-build.js && node scripts/link-packages.js",
    "build": "pnpm run prebuild && npx prisma generate",
    "docz::build": "rimraf ./docs/ && jsdoc -c .jsdoc.json -r .",
    "docz::start": "cd ./docs && http-server ./"
  },
  "dependencies": {
    "@babel/eslint-parser": "7.23.9",
    "@babel/plugin-proposal-pipeline-operator": "7.23.3",
    "@eslint/compat": "^1.1.1",
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.7.0",
    "@prisma/client": "5.18.0",
    "app-root-path": "3.1.0",
    "argon2": "^0.30.3",
    "bcryptjs": "^2.4.3",
    "bs58": "^6.0.0",
    "cross-env": "^10.1.0",
    "debug": "4.3.4",
    "dotenv": "16.4.1",
    "enum": "3.0.4",
    "eslint-config-semistandard": "17.0.0",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.29.1",
    "eslint-plugin-n": "15.7.0",
    "eslint-plugin-promise": "6.1.1",
    "esm": "^3.2.25",
    "exceljs": "^4.4.0",
    "fix-esm": "^1.0.1",
    "fs-capacitor": "8.0.0",
    "globals": "^15.8.0",
    "graphql": "16.8.0",
    "graphql-import-node": "0.0.5",
    "grunt-jsdoc": "2.4.1",
    "gsm": "^0.1.4",
    "htmlparser": "1.7.7",
    "mcc-mnc-list": "1.1.11",
    "nanolith": "^0.4.6",
    "nodemailer": "^8.0.1",
    "pdfmake": "^0.3.11",
    "prisma": "5.18.0",
    "razorpay": "^2.9.5",
    "rc-parser": "1.0.2",
    "rimraf": "5.0.5",
    "tweetnacl": "^1.0.3",
    "uuid": "^9.0.1",
    "vercel": "^37.2.1"
  },
  "devDependencies": {
    "@babel/cli": "7.23.9",
    "@babel/core": "7.23.9",
    "@babel/node": "7.23.9",
    "@babel/plugin-proposal-export-default-from": "7.23.3",
    "@babel/plugin-proposal-export-namespace-from": "7.18.9",
    "@babel/plugin-proposal-object-rest-spread": "7.20.7",
    "@babel/plugin-proposal-partial-application": "7.23.3",
    "@babel/plugin-proposal-throw-expressions": "7.23.3",
    "@babel/plugin-syntax-class-properties": "7.12.13",
    "@babel/plugin-syntax-export-default-from": "7.23.3",
    "@babel/plugin-transform-modules-commonjs": "7.23.3",
    "@babel/plugin-transform-runtime": "7.23.9",
    "@babel/plugin-transform-shorthand-properties": "7.23.3",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.23.9",
    "@babel/register": "7.23.7",
    "@babel/runtime": "7.23.9",
    "babel-eslint": "10.1.0",
    "babel-loader": "9.1.3",
    "babel-node": "0.0.1-security",
    "babel-plugin-dynamic-import-node": "2.3.3",
    "babel-plugin-inline-json-import": "0.3.2",
    "babel-plugin-minify-dead-code-elimination": "^0.5.2",
    "babel-plugin-module-resolver": "5.0.0",
    "babel-plugin-root-import": "6.6.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "babel-watch": "7.8.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-prettier": "5.1.3",
    "husky": "8.0.3",
    "lint-staged": "10.4.0",
    "npm": "10.4.0",
    "npm-check-updates": "16.14.14",
    "pnpm": "8.15.0"
  },
  "engines": {
    "node": ">=20"
  }
}